<!DOCTYPE html>
<html>
<head>
    <title>Cadastro de Álbum</title>
</head>
<body>

    <h1><%= album ? "Editar Álbum" : "Cadastrar Álbum" %></h1>

    <form action="<%= album ? '/album/editar/' + album.id : '/album/cadastrar' %>"
          method="POST">

        <label>Título:</label>
        <input type="text" name="titulo"
               value="<%= album ? album.titulo : '' %>" required>

        <br><br>

        <label>Artista:</label>
        <input type="text" name="artista"
               value="<%= album ? album.artista : '' %>" required>

        <br><br>

        <label>Ano:</label>
        <input type="number" name="ano"
               value="<%= album ? album.ano : '' %>" required>

        <br><br>

        <button type="submit">Salvar</button>
        <a href="/album">Cancelar</a>

    </form>

</body>
</html>