<%- include ('partials/header.ejs')%>
<%- include ('partials/navbar.ejs') %>
<a href="/"> << Voltar</a>
    <br><br>

    <a href="/album/cadastrar">Cadastrar álbum</a>

    <br><br>

    <table border="1" >
        <tr>
            <th>Título</th>
            <th>Artista</th>
            <th>Ano</th>
            <th>Ações</th>
        </tr>

        <% album.forEach(function(albums) { %>
            <tr>
                <td><%= albums.titulo %></td>
                <td><%= albums.artista %></td>
                <td><%= albums.ano %></td>
                <td>
                    <a href="/album/editar/<%= albums.id %>">Editar</a>

                    <form action="/album/excluir/<%= albums.id %>"
                          method="POST"
                          style="display:inline">
                        <button type="submit">Excluir</button>
                    </form>
                </td>
            </tr>
        <% }); %>
    </table>

</body>
</html>