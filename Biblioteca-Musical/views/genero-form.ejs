<!DOCTYPE html>
<html>
<head>
    <title>Cadastro de Gênero</title>
</head>
<body>

    <h1><%= genero ? "Editar Gênero" : "Cadastrar Gênero" %></h1>

    <form action="<%= genero ? '/genero/editar/' + genero.id : '/genero/cadastrar' %>"
          method="POST">

        <label>Nome:</label>
        <input type="text" name="nome"
               value="<%= genero ? genero.nome : '' %>" required>

        <br><br>

        <label>Descrição:</label>
        <input type="text" name="descricao"
               value="<%= genero ? genero.descricao : '' %>" required>

        <br><br>

        <button type="submit">Salvar</button>
        <a href="/genero">Cancelar</a>

    </form>

</body>
</html>