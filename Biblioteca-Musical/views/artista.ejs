<%- include ('partials/header.ejs')%>
<%- include ('partials/navbar.ejs') %>
    <a href="/"> << Voltar</a>
    <br><br>
    

    <a href="/artista/cadastrar">Cadastrar artista</a>

    <br><br>

    <table border="1">
        <tr>
            <th>Nome</th>
            <th>Nacionalidade</th>
            <th>Nascimento</th>
            <th>Ações</th>
        </tr>

        <% artistas.forEach(function(artistas) { %>
            <tr>
                <td><%= artistas.nome %></td>
                <td><%= artistas.nacionalidade %></td>
                <td><%= artistas.nascimento %></td>
                <td>
                    <a href="/artista/editar/<%= artistas.id %>">Editar</a>

                    <form action="/artista/excluir/<%= artistas.id %>"
                          method="POST"
                          style="display:inline">
                        <button type="submit">Excluir</button>
                    </form>
                </td>
            </tr>
        <% }); %>
    </table>

</body>
</html>

