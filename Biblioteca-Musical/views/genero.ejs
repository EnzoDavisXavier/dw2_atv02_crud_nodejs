<%- include ('partials/header.ejs')%>
<%- include ('partials/navbar.ejs') %>
    <a href="/"> << Voltar</a>
    <br><br>


    <a href="/genero/cadastrar">Cadastrar gênero</a>

    <br><br>

    <table border="1">
        <tr>
            <th>Nome</th>
            <th>Descrição</th>
            <th>Ações</th>
        </tr>

        <% genero.forEach(function(generos) { %>
            <tr>
                <td><%= generos.nome %></td>
                <td><%= generos.descricao %></td>
                <td>
                    <a href="/genero/editar/<%= generos.id %>">Editar</a>

                    <form action="/genero/excluir/<%= generos.id %>"
                          method="POST"
                          style="display:inline">
                        <button type="submit">Excluir</button>
                    </form>
                </td>
            </tr>
        <% }); %>
    </table>

</body>
</html>

